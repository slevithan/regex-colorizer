{
  "name": "regex-colorizer-ts",
  "version": "1.0.2",
  "description": "Highlight regex syntax",
  "homepage": "https://github.com/milselarch/regex-colorizer",
  "author": "milselarch",
  "license": "MIT",
  "type": "module",
  "exports": "./src/index.js",
  "browser": "./dist/regex-colorizer.min.js",
  "scripts": {
    "prebuild": "rimraf --glob dist/*",
    "build-js": "esbuild src/index.ts --bundle --minify --outfile=dist/regex-colorizer.min.js --global-name=RegexColorizer",
    "build": "tsup",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "pnpm build"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slevithan/regex-colorizer.git"
  },
  "keywords": [
    "regex",
    "regexp",
    "syntax-highlighting"
  ],
  "devDependencies": {
    "esbuild": "^0.27.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1"
  },
  "packageManager": "pnpm@10.32.0",
  "dependencies": {
    "typescript": "^6.0.3"
  }
}
