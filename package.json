{
  "name": "regex-colorizer-ts",
  "version": "1.0.3",
  "description": "Highlight regex syntax",
  "homepage": "https://slevithan.github.io/regex-colorizer/demo/",
  "author": "Steven Levithan",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "browser": "./dist/regex-colorizer.min.js",
  "scripts": {
    "prebuild": "rimraf --glob dist/*",
    "build-js": "esbuild src/index.ts --bundle --minify --outfile=dist/regex-colorizer.min.js --global-name=RegexColorizer",
    "build": "tsup",
    "prepare": "pnpm build",
    "test": "node --test './src/**/*.test.ts'",
    "types:check": "tsc --noEmit",
    "prepack": "tsc"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slevithan/regex-colorizer.git"
  },
  "keywords": [
    "regex",
    "regexp",
    "syntax-highlighting"
  ],
  "devDependencies": {
    "esbuild": "^0.27.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1"
  },
  "packageManager": "pnpm@10.32.0",
  "dependencies": {
    "typescript": "^6.0.3"
  }
}
